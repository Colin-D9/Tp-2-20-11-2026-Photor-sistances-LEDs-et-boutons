#include <stdio.h>
#include <stdlib.h>
#include <pigpiod_if2.h>

#define LDR_A 4
#define LED_JAUNE 12

int main(void)
{
    double t0, reaction;
    float delai;

    int pi = pigpio_start(NULL, NULL);
    if (pi < 0)
    {
        printf("Impossible de se connecter a pigpiod\n");
        exit(1);
    }
    set_mode(pi, LDR_A, PI_INPUT);
    set_pull_up_down(pi, LDR_A, PI_PUD_UP);
    set_mode(pi, LED_JAUNE, PI_OUTPUT);

    srand((unsigned int)time_time());      /* graine du hasard */

    while (1)
    {
        printf("Decouvrez la LDR A, puis attendez la LED jaune...\n");
        while (gpio_read(pi, LDR_A) == PI_HIGH)   /* attendre que A soit eclairee */
        {
            time_sleep(0.05);
        }

        delai = 2.0 + (rand() % 4);               /* 2 a 5 secondes */
        time_sleep(delai);

        gpio_write(pi, LED_JAUNE, PI_HIGH);       /* GO ! */
        t0 = time_time();

        while (gpio_read(pi, LDR_A) == PI_LOW)    /* attendre que A soit cachee */
        {
            time_sleep(0.001);
        }
        reaction = time_time() - t0;

        gpio_write(pi, LED_JAUNE, PI_LOW);
        printf("Temps de reaction : %.3f s\n\n", reaction);
        time_sleep(1.0);
    }

    pigpio_stop(pi);
    return 0;
}
